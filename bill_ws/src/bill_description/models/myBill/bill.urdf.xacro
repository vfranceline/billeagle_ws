<?xml version="1.0"?>
<robot name="bill" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>
    
    <!-- Robot Variables -->
    <xacro:property name="chassis_length" value="0.5"/>
    <xacro:property name="chassis_width" value="0.3"/>
    <xacro:property name="chassis_height" value="1.17"/>
    <xacro:property name="chassis_mass" value="22.2"/>
    <xacro:property name="lidar_height" value="0.3"/>
    <xacro:property name="wheel_radius" value="0.07"/>
    <xacro:property name="wheel_thickness" value="0.05"/> 
    <xacro:property name="wheel_mass" value="0.2"/>
    <xacro:property name="wheel_offset_x" value="0.2"/>
    <xacro:property name="wheel_offset_y" value="${chassis_width/2 + wheel_thickness/2}"/>
    <xacro:property name="wheel_offset_z" value="${- chassis_height/2 + wheel_radius}"/>

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="gray">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>
    
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <link name="base_link"/>

    <!-- Chassis -->
    <link name="chassis">
        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 -0.3" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- Wheels -->
    <xacro:macro name="wheel" params="name">
        <link name="${name}">
            <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <!-- rotaciona o cilindro para que o eixo longo fique em Y (o eixo de rotação) -->
            <origin rpy="1.5708 0 0" xyz="0 0 0"/>
            <material name="white"/>
            </visual>
            <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <origin rpy="1.5708 0 0" xyz="0 0 0"/>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}"
                                    length="${wheel_thickness}"
                                    radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
    </xacro:macro>

    <xacro:wheel name="wheel_front_left"/>
    <xacro:wheel name="wheel_front_right"/>
    <xacro:wheel name="wheel_rear_left"/>
    <xacro:wheel name="wheel_rear_right"/>  

     <!-- Lidar's urdf-->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_link"/>
        <origin xyz="0.3 0 ${- chassis_height/2 + lidar_height}" rpy="0 0 0"/>
    </joint>
    
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.05" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- 2D Lidar Gazebo Sensor Plugin  -->
    <gazebo reference="laser_link">
        <sensor name="laser" type="ray">
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <ray>
            <scan>
                <horizontal>
                <samples>140</samples>
                <min_angle>-0.8727</min_angle>
                <max_angle> 0.8727</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.3</min>
                <max>12</max>
            </range>
            </ray>
            <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
            <ros>
                <namespace>/</namespace>
                <!-- remapeia o tópico interno “~/out” para “/scan” -->
                <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>laser_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- base_footprint fixo ao base_link -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/> 
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <gazebo reference="chassis">
        <mu1 value="1.0"/>
        <mu2 value="0.2"/>
    </gazebo>

    <!-- Chassis fixado à base -->
    <joint name="base_to_chassis" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
    </joint>

    <!-- Juntas das rodas mecanum -->
    <joint name="wheel_front_left_joint" type="continuous">
        <parent link="chassis"/>
        <child link="wheel_front_left"/>
        <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="wheel_front_right_joint" type="continuous">
        <parent link="chassis"/>
        <child link="wheel_front_right"/>
        <origin xyz="${wheel_offset_x} ${-wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="wheel_rear_left_joint" type="continuous">
        <parent link="chassis"/>
        <child link="wheel_rear_left"/>
        <origin xyz="${-wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="wheel_rear_right_joint" type="continuous">
        <parent link="chassis"/>
        <child link="wheel_rear_right"/>
        <origin xyz="${-wheel_offset_x} ${-wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- 1) Transmissions -->
    <xacro:macro name="simple_transmission" params="joint actuator">
        <transmission name="${joint}_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="${joint}">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="${actuator}">
            <mechanicalReduction>1</mechanicalReduction>
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </actuator>
        </transmission>
    </xacro:macro>
    <xacro:simple_transmission joint="wheel_front_left_joint"  actuator="wheel_front_left_motor"/>
    <xacro:simple_transmission joint="wheel_front_right_joint" actuator="wheel_front_right_motor"/>
    <xacro:simple_transmission joint="wheel_rear_left_joint"   actuator="wheel_rear_left_motor"/>
    <xacro:simple_transmission joint="wheel_rear_right_joint"  actuator="wheel_rear_right_motor"/>

    <!-- 2) Plugin ros2_control para Gazebo -->
    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <robotNamespace/>
        <controlPeriod>0.01</controlPeriod>
        <robotSimType>gazebo_ros2_control/DefaultRobotHWSim</robotSimType>
        </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="libgazebo_ros_planar_move.so" name="mecanum_drive">
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <odometryRate>100.0</odometryRate>
        <robotBaseFrame>base_footprint</robotBaseFrame>
        <publishTF>True</publishTF>
      </plugin>
    </gazebo>

</robot>
